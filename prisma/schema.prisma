// Prisma schema for HedgeHint.
// Migrations are created with `prisma migrate dev` and applied from a trusted machine, never during build.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth.js (credentials) adapter models ----------
model User {
  id                String         @id @default(uuid()) @db.Uuid
  name              String?
  email             String?        @unique
  emailVerified     DateTime?
  image             String?
  passwordHash      String?
  role              String         @default("viewer")
  mustChangePassword Boolean      @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  accounts          Account[]
  sessions          Session[]
  members           OrganisationMember[]
  auditEvents       AuditEvent[]         @relation("AuditActor")
  purchaseRequests  PurchaseRequest[]    @relation("Requester")
  approvals         PurchaseRequest[]    @relation("Approver")
  currencyBought    CurrencyBought[]     @relation("Recorder")
  scenarios         Scenario[]           @relation("Creator")
  importJobs        ImportJob[]          @relation("Importer")
  rateAlerts        RateAlert[]          @relation("AlertCreator")
  @@map("users")
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("sessions")
  @@index([userId, expires])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@id([identifier, token])
  @@map("verification_tokens")
}

// ---------- Tenant ----------
model Organisation {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  baseCurrency String   @db.Char(3)
  riskAppetite String   @default("medium")
  status       String   @default("active")
  createdAt    DateTime @default(now())
  createdBy    String?  @db.Uuid
  members      OrganisationMember[]
  purchaseOrders     PurchaseOrder[]
  supplierInvoices   SupplierInvoice[]
  paymentSchedules   PaymentSchedule[]
  exchangeRates      ExchangeRate[]
  rateAlerts         RateAlert[]
  purchaseRequests   PurchaseRequest[]
  currencyBought     CurrencyBought[]
  scenarios          Scenario[]
  importJobs         ImportJob[]
  auditEvents        AuditEvent[]
  rateProviders      RateProvider[]
  @@map("organisations")
}

model SupplierInvoice {
  id               String   @id @default(uuid()) @db.Uuid
  organisationId   String   @db.Uuid
  organisation     Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  purchaseOrderId  String?  @db.Uuid
  supplierName     String
  invoiceRef       String?
  currency         String   @db.Char(3)
  amount           Decimal  @db.Decimal(18, 4)
  dueDate          DateTime
  status           String   @default("open")
  baseValueAtImport Decimal? @db.Decimal(18, 4)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  purchaseOrder    PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  @@map("supplier_invoices")
  @@index([organisationId, dueDate, status])
}

model PaymentSchedule {
  id            String   @id @default(uuid()) @db.Uuid
  organisationId String  @db.Uuid
  organisation  Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  currency      String   @db.Char(3)
  amount        Decimal  @db.Decimal(18, 4)
  dueDate       DateTime
  source        String
  linkedRecordId String? @db.Uuid
  status        String   @default("pending")
  @@map("payment_schedules")
  @@index([organisationId, dueDate, status])
}

// ---------- Rates ----------
model ExchangeRate {
  id           String   @id @default(uuid()) @db.Uuid
  organisationId String   @db.Uuid
  organisation  Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  currencyPair String   @db.Char(7)
  rate         Decimal  @db.Decimal(18, 6)
  source       String   @default("manual")
  observedAt   DateTime
  recordedAt   DateTime @default(now())
  @@map("exchange_rates")
  @@unique([currencyPair, observedAt])
  @@index([currencyPair, observedAt])
}

model RateProvider {
  id           String   @id @default(uuid()) @db.Uuid
  organisationId String @db.Uuid
  organisation  Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  provider     String
  apiKeyEnc    String?  @db.Text
  enabled      Boolean  @default(false)
  lastSyncAt   DateTime?
  @@map("rate_providers")
  @@index([organisationId])
}

model OrganisationMember {
  organisationId String   @db.Uuid
  userId         String   @db.Uuid
  role           String   @default("member")
  joinedAt       DateTime @default(now())
  invitedBy      String?  @db.Uuid
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([organisationId, userId])
  @@map("organisation_members")
  @@index([organisationId, userId])
}

// ---------- Exposure ----------
model PurchaseOrder {
  id                 String     @id @default(uuid()) @db.Uuid
  organisationId     String     @db.Uuid
  organisation       Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  supplierName       String
  supplierRef        String?
  currency           String     @db.Char(3)
  amount             Decimal    @db.Decimal(18, 4)
  orderDate          DateTime
  expectedPaymentDate DateTime
  status             String     @default("open")
  baseValueAtImport  Decimal?   @db.Decimal(18, 4)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  invoices           SupplierInvoice[]
  @@map("purchase_orders")
  @@index([organisationId, expectedPaymentDate, status])
}

// ---------- Alerts ----------
model RateAlert {
  id            String   @id @default(uuid()) @db.Uuid
  organisationId String  @db.Uuid
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  currencyPair  String   @db.Char(7)
  thresholdRate Decimal  @db.Decimal(18, 6)
  direction     String
  status        String   @default("active")
  createdBy     String   @db.Uuid
  alertCreator  User     @relation("AlertCreator", fields: [createdBy], references: [id])
  triggeredAt   DateTime?
  acknowledgedBy String? @db.Uuid
  acknowledgedAt DateTime?
  @@map("rate_alerts")
  @@index([organisationId, status])
}

// ---------- Hedge requests & buys ----------
model PurchaseRequest {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @db.Uuid
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  currency       String   @db.Char(3)
  amount         Decimal  @db.Decimal(18, 4)
  targetRate     Decimal? @db.Decimal(18, 6)
  rationale      String?
  status         String   @default("requested")
  requestedBy    String   @db.Uuid
  requester      User     @relation("Requester", fields: [requestedBy], references: [id])
  requestedAt    DateTime @default(now())
  approvedBy     String?  @db.Uuid
  approver       User?    @relation("Approver", fields: [approvedBy], references: [id])
  approvedAt     DateTime?
  rejectionReason String?
  currencyBought   CurrencyBought[]
  @@map("purchase_requests")
  @@index([organisationId, status])
}

model CurrencyBought {
  id                 String   @id @default(uuid()) @db.Uuid
  organisationId     String   @db.Uuid
  organisation       Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  purchaseRequestId  String?  @db.Uuid
  purchaseRequest    PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id])
  currency           String   @db.Char(3)
  amount             Decimal  @db.Decimal(18, 4)
  rateAchieved       Decimal  @db.Decimal(18, 6)
  boughtAt           DateTime
  marketRateAtPurchase Decimal @db.Decimal(18, 6)
  savingBaseCurrency Decimal  @db.Decimal(18, 4)
  recordedBy         String   @db.Uuid
  recorder           User     @relation("Recorder", fields: [recordedBy], references: [id])
  @@map("currency_bought")
  @@index([organisationId, boughtAt])
}

// ---------- Scenarios ----------
model Scenario {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @db.Uuid
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  rateShiftPercent Decimal @db.Decimal(5, 2)
  currencyPair   String   @db.Char(7)
  isSaved        Boolean  @default(false)
  createdBy      String   @db.Uuid
  creator        User     @relation("Creator", fields: [createdBy], references: [id])
  createdAt      DateTime @default(now())
  @@map("scenarios")
}

// ---------- Imports ----------
model ImportJob {
  id          String   @id @default(uuid()) @db.Uuid
  organisationId String @db.Uuid
  organisation Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  fileName    String
  status      String   @default("pending")
  rowsTotal   Int      @default(0)
  rowsOk      Int      @default(0)
  rowsError   Int      @default(0)
  createdBy   String   @db.Uuid
  importer    User     @relation("Importer", fields: [createdBy], references: [id])
  createdAt   DateTime @default(now())
  completedAt DateTime?
  errors      ImportError[]
  @@map("import_jobs")
}

model ImportError {
  importJobId String @db.Uuid
  rowNumber   Int
  field       String
  message     String
  job         ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  @@id([importJobId, rowNumber, field])
  @@map("import_errors")
}

// ---------- Audit ----------
model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  organisationId String  @db.Uuid
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  userId        String?  @db.Uuid
  auditActor    User?    @relation("AuditActor", fields: [userId], references: [id])
  action        String
  entityType    String
  entityId      String?
  details       Json     @default("{}")
  createdAt     DateTime @default(now())
  ipAddress     String?
  @@map("audit_events")
  @@index([organisationId, createdAt])
}

