# HedgeHint environment template.
# Copy to .env and fill in values. Never commit real secrets.
# Credentials for production live in ~/.config/hedgehint/ (permissions 600), outside this repository.

DATABASE_URL="postgres://hedgehint:hedgehint@localhost:5433/hedgehint?sslmode=disable"
DATABASE_URL_MIGRATION="postgres://hedgehint:hedgehint@localhost:5433/hedgehint?sslmode=disable"
DIRECT_URL="postgres://hedgehint:hedgehint@localhost:5433/hedgehint?sslmode=disable"

NEXTAUTH_SECRET="replace-with-a-32-character-random-secret"
ENCRYPTION_KEY="replace-with-a-32-character-encryption-key"

SCHEDULER_SECRET="replace-with-scheduler-secret"

STORAGE_BUCKET="hedgehint-dev"
STORAGE_KEY="replace-with-storage-key"
STORAGE_SECRET="replace-with-storage-secret"
STORAGE_REGION="us-east-1"
STORAGE_ENDPOINT=""

RATE_PROVIDER_URL="https://api.exchangerate.host"
RATE_PROVIDER_API_KEY=""

HEDGEHINT_DEV_SIMULATOR="false"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
